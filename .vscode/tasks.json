{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "COREBIQ Module Runner",
      "type": "shell",
      "command": "node js/module-manager.js --port 4177",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": {
        "owner": "corebiq-module-manager",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^COREBIQ Module Manager is running\\.",
          "endsPattern": "^COREBIQ Module Manager is running\\."
        }
      }
    }
  ]
}
