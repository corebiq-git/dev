rules_version = '2';service cloud.firestore {match /databases/{database}/documents {
function signedIn(){return request.auth!=null}
function profile(){return get(/databases/$(database)/documents/users/$(request.auth.uid))}
function active(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().data.status=='active'}
function role(){return profile().data.role}
function admin(){return active() && role() in ['super_admin','admin']}
function branchAllowed(b){return admin() || (active() && b in profile().data.branchIds)}
function ops(){return active() && role() in ['super_admin','admin','branch_manager','receptionist']}
match /users/{uid}{allow read:if active() && (request.auth.uid==uid || role() in ['super_admin','admin']);allow write:if false;}
match /branches/{id}{allow read:if active() && (admin() || branchAllowed(resource.data.businessId) || branchAllowed(id));allow write:if false;}
match /services/{id}{allow read:if active();allow write:if false;}
match /patients/{id}{allow read:if active() && role() in ['super_admin','admin','branch_manager','physiotherapist','receptionist'] && branchAllowed(resource.data.branchId);allow write:if false;}
match /appointments/{id}{allow read:if active() && role() in ['super_admin','admin','branch_manager','physiotherapist','receptionist'] && branchAllowed(resource.data.branchId);allow write:if false;}
match /staff/{id}{allow read:if active() && (admin() || branchAllowed(resource.data.branchId));allow write:if false;}
match /{document=**}{allow read,write:if false;}
}}
